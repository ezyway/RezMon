<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.rezmon" path="/org/gnome/shell/extensions/rezmon/">

    <!-- existing -->
    <key name="b-open" type="s"><default>"("</default></key>
    <key name="b-close" type="s"><default>")"</default></key>
    <key name="delimiter" type="s"><default>"|"</default></key>

    <key name="show-cpu" type="b"><default>true</default></key>
    <key name="show-gpu" type="b"><default>true</default></key>
    <key name="show-ram" type="b"><default>true</default></key>
    <key name="show-swap" type="b"><default>false</default></key>
    <key name="show-disk" type="b"><default>false</default></key>
    <key name="show-net" type="b"><default>true</default></key>

    <key name="update-interval" type="i"><default>1</default></key>
    <key name="spacing" type="s"><default>"normal"</default></key>
    <key name="temp-unit" type="s"><default>"celsius"</default></key>
    <key name="label-style" type="s"><default>"text"</default></key>
    <key name="metric-order" type="as"><default>['cpu', 'gpu', 'ram', 'swap', 'disk', 'net']</default></key>
    <key name="panel-position" type="s"><default>"right"</default></key>
    <key name="panel-priority" type="i"><default>0</default></key>
    <key name="clock-position" type="s"><default>"center"</default></key>
    <key name="show-tooltip" type="b"><default>false</default></key>

    <!-- NEW: CPU -->
    <key name="cpu-usage" type="b"><default>true</default></key>
    <key name="cpu-clock" type="b"><default>true</default></key>
    <key name="cpu-temp" type="b"><default>true</default></key>

    <!-- NEW: GPU -->
    <key name="gpu-device" type="s"><default>"auto"</default></key>
    <key name="gpu-usage" type="b"><default>true</default></key>
    <key name="gpu-clock" type="b"><default>false</default></key>
    <key name="gpu-temp" type="b"><default>true</default></key>
    <key name="gpu-vram-used" type="b"><default>true</default></key>
    <key name="gpu-vram-free" type="b"><default>false</default></key>
    <key name="gpu-vram-percent" type="b"><default>false</default></key>

    <!-- NEW: RAM -->
    <key name="ram-used" type="b"><default>true</default></key>
    <key name="ram-free" type="b"><default>true</default></key>
    <key name="ram-percent" type="b"><default>false</default></key>
    <key name="ram-free-percent" type="b"><default>false</default></key>

    <!-- NEW: SWAP -->
    <key name="swap-used" type="b"><default>true</default></key>
    <key name="swap-free" type="b"><default>false</default></key>
    <key name="swap-percent" type="b"><default>true</default></key>
    <key name="swap-free-percent" type="b"><default>false</default></key>

    <!-- NEW: DISK -->
    <key name="disk-read" type="b"><default>true</default></key>
    <key name="disk-write" type="b"><default>true</default></key>
    <key name="disk-space-used" type="b"><default>false</default></key>
    <key name="disk-space-free" type="b"><default>false</default></key>
    <key name="disk-space-percent" type="b"><default>false</default></key>

    <!-- NEW: NET -->
    <key name="net-interface" type="s"><default>"auto"</default></key>
    <key name="net-down" type="b"><default>true</default></key>
    <key name="net-up" type="b"><default>true</default></key>

    <key name="warn-threshold" type="i"><default>70</default></key>
    <key name="crit-threshold" type="i"><default>90</default></key>

    <key name="temp-warn-threshold" type="i"><default>75</default></key>
    <key name="temp-crit-threshold" type="i"><default>85</default></key>

    <!-- Icons / Symbols -->
    <key name="symbol-cpu" type="s"><default>"⚡"</default></key>
    <key name="symbol-gpu" type="s"><default>"🎮"</default></key>
    <key name="symbol-ram" type="s"><default>"🧠"</default></key>
    <key name="symbol-swap" type="s"><default>"⇄"</default></key>
    <key name="symbol-disk" type="s"><default>"💽"</default></key>
    <key name="symbol-net" type="s"><default>"📶"</default></key>
  </schema>
</schemalist>